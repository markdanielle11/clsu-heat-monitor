{
  "name": "clsu-heat-backend",
  "version": "1.0.0",
  "description": "Heat index monitoring and push alert backend for CLSU",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx --env-file=.env scripts/demo-snapshot.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo-server-sdk": "^8.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
