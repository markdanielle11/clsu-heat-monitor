# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/clsu_heat
# Long random strings (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_API_KEY=change-me-to-a-long-random-string
TOKEN_SECRET=change-me-to-a-different-long-random-string-32chars-min
PORT=3000
# Optional
# CORS_ORIGINS=https://markdanielle11.github.io   # lets the GitHub Pages web version call this API
# EXPO_ACCESS_TOKEN=            # enable "enhanced push security" in your Expo account, then set this
# FORECAST_CRON=*/15 * * * *
# OPEN_METEO_API_KEY=           # only for Open-Meteo commercial plans
